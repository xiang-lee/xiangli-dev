/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self'; form-action 'self'; upgrade-insecure-requests

# Weekend JS/CSS change with the page. Keep this shorter than Cloudflare's
# default asset cache so a new index.html is not stuck on a stale app.js.
/weekend/*.js
  Cache-Control: public, max-age=300, must-revalidate

/weekend/*.css
  Cache-Control: public, max-age=300, must-revalidate
